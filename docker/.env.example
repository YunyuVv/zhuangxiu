# 环境变量配置示例
# 使用方式：cp docker/.env.example docker/.env  然后按需修改
# 注意：.env 含密码，已在 .gitignore / .dockerignore 中忽略，切勿提交到仓库。
# .env 文件需放在 docker/ 目录下（与 docker-compose.yml 同级）。

# ── 数据库（PostgreSQL）──────────────────────────────────────────
DB_NAME=zhuangxiu
DB_USERNAME=zhuangxiu
DB_PASSWORD=zhuangxiu

# ── Redis ────────────────────────────────────────────────────────
# 默认空密码（与后端 REDIS_PASSWORD 默认值一致）。
# 如设置密码，需同时同步 REDIS_PASSWORD 与后端环境变量。
REDIS_PASSWORD=

# ── 后端 ─────────────────────────────────────────────────────────
# 默认使用 GraalVM Native 镜像（启动快、内存省）。
# 如需切换为 JVM 镜像，改为：ghcr.io/<你的GitHub用户名>/zhuangxiu-server:latest
ZHUANGXIU_SERVER_IMAGE=ghcr.io/idea-flow/zhuangxiu-server-native:latest
# JWT 签名密钥：必须 >=32 字节！生成命令：openssl rand -hex 32
# 正式环境务必替换为随机值，且前后端共用同一份（否则已签发 token 失效）。
APP_JWT_SECRET=zhuangxiu-default-secret-please-change-me-32b
SPRING_PROFILES_ACTIVE=prod-docker
# 仅 docker-compose-server.yml 模式对外暴露的端口
SERVER_PORT=9096

# ── 前端（仅 docker-compose.yml 纯 Docker 模式使用）──────────────
# 如使用自定义镜像：ghcr.io/<你的GitHub用户名>/zhuangxiu-web:latest
ZHUANGXIU_WEB_IMAGE=ghcr.io/idea-flow/zhuangxiu-web:latest

# ── Nginx（仅 docker-compose.yml 纯 Docker 模式使用）─────────────
# nginx 对外监听的 HTTP 端口（80 为默认；如需改端口如 8080，把左侧改为 8080）
NGINX_HTTP_PORT=80
# 前端域名：访问该域名打开 Web 页面；生产示例：zx.example.com。
# 只填写域名，不带 http(s)://、端口或路径；前后端域名必须不同。
FRONTEND_DOMAIN=localhost
# 后端服务域名：供小程序等调用 /api/...；生产示例：api.example.com。
# Nginx 启动时自动读取这两个变量生成配置，无需再手改 server_name。
BACKEND_DOMAIN=api.localhost
# 域名需解析到服务器；HTTPS 证书与小程序 request 合法域名需另外配置。

# ── 通用 ─────────────────────────────────────────────────────────
TZ=Asia/Shanghai

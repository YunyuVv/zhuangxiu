# syntax=docker/dockerfile:1.7

# JAR 构建阶段：在 Maven 镜像内构建 zhuangxiu-server 的 Spring Boot 可执行 JAR。
FROM maven:3.9.11-eclipse-temurin-25 AS builder

WORKDIR /workspace

# 仅复制后端源码，避免把无关工程带入构建上下文。
COPY server ./server

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -f server/pom.xml -DskipTests clean package

# JVM 运行阶段：只保留最终 JAR 与运行时 JRE。
FROM eclipse-temurin:25-jre

WORKDIR /app

# 复制构建好的 Spring Boot 可执行 JAR（版本号以通配符匹配）。
COPY --from=builder /workspace/server/target/zhuangxiu-server-*.jar /app/zhuangxiu-server.jar

EXPOSE 9096

# JVM 镜像默认使用 prod-docker profile 启动。
ENTRYPOINT ["java", "-Xms128m", "-Xmx1g", "-Dspring.profiles.active=prod-docker", "-jar", "/app/zhuangxiu-server.jar"]

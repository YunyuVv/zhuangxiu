# syntax=docker/dockerfile:1.7

# Maven 提供阶段：直接复用官方 Maven 镜像中的 Maven 安装目录，
# 避免在 GraalVM 镜像内再走系统包管理器。
FROM maven:3.9.11-eclipse-temurin-25 AS maven

# Native 构建阶段：在 GraalVM 容器内构建 zhuangxiu-server 的原生二进制。
FROM ghcr.io/graalvm/native-image-community:25 AS builder

# 复制 Maven 运行目录与启动脚本，让当前 Builder 镜像可直接执行 mvn。
COPY --from=maven /usr/share/maven /usr/share/maven
COPY --from=maven /usr/bin/mvn /usr/bin/mvn

# 配置 Maven 环境变量。
ENV MAVEN_HOME=/usr/share/maven
ENV PATH="${MAVEN_HOME}/bin:${PATH}"

WORKDIR /workspace

# 仅复制后端源码，减少构建上下文并避免把无关工程带入镜像。
COPY server ./server

# 构建 Native 二进制（native profile 已将 native:compile 绑定到 package 阶段，
# 因此 `mvn -Pnative clean package` 一步产出 target/zhuangxiu-server）。
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -f server/pom.xml -DskipTests -Pnative clean package

# 运行阶段：只保留原生可执行文件与最小运行依赖，减小最终镜像体积。
FROM debian:bookworm-slim AS runtime

# 安装常见运行依赖：证书、时区与 Native 二进制常见依赖库。
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tzdata libstdc++6 zlib1g && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制 Native 可执行文件作为镜像最终产物。
COPY --from=builder /workspace/server/target/zhuangxiu-server /app/zhuangxiu-server

RUN chmod +x /app/zhuangxiu-server

# 运行时默认启用 prod-docker profile（连接容器网络内的 PostgreSQL 与 Redis）。
ENV TZ=Asia/Shanghai \
    SPRING_PROFILES_ACTIVE=prod-docker

EXPOSE 9096

# Native 镜像直接启动二进制，不再经过 java -jar。
ENTRYPOINT ["/app/zhuangxiu-server"]
